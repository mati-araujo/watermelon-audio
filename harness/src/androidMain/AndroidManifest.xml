<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      RECORD_AUDIO esta desde el primer commit del harness a proposito: el
      control que justifica el proyecto es el monitor de entrada, y el caso que
      mas importa probar es el del permiso NEGADO (item 3 del smoke: la
      regresion plausible en startInputStream). Agregar el permiso despues
      obligaria a reinstalar para reproducirlo.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      MINI-038: el panel USB usa USB host (libusb con el fd de UsbManager.openDevice()).
      required="false": el harness tiene que instalarse igual en un device sin USB host. El permiso
      de USB host NO es un uses-permission: es un dialogo del sistema por dispositivo, en runtime.
    -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!--
      MINI-038: `UsbAudioManager.startStreaming` toma un wake lock, y sin este permiso tira un
      SecurityException (medido en el g42; el streaming sigue, pero el lock no). La librería no lo
      declara en su manifest; NoisyPad lo tiene por el merge de otro módulo. Es un permiso normal,
      concedido al instalar.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:label="WMA Harness"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
